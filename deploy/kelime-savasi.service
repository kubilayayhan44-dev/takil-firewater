[Unit]
Description=Takıl Kelime Savaşı (1v1 Türkçe kelime oyunu)
After=network.target

[Service]
Type=simple
User=root
# Oyun kendi bağımsız Express + Socket.IO server'ı — dev-server.js'a da
# Express API proxy'sine de ihtiyaç duymaz (DISABLE_API_PROXY gereksiz).
WorkingDirectory=/opt/takil-app/games/kelime-savasi
Environment=PORT=8766
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /opt/takil-app/games/kelime-savasi/server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
